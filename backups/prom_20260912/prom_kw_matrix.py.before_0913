# Епітети, які нічого не додають до пошукового запиту: покупець не вводить
# «потужний» — він вводить предмет.
FLUFF = {'потужний', 'потужна', 'розкішний', 'розкішна', 'елегантний', 'елегантна',
         'стильний', 'стильна', 'преміальний', 'преміальна', 'компактний',
