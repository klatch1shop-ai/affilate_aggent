}

# «Призначення» — прикметники множини («кліторні»), як означення до однини
# вони не узгоджуються. Покупець однаково вводить прийменникову форму:
# шукають «вібратор для клітора», а не «вібратор кліторні».
PURPOSE_PHRASE = {
    'кліторні': 'для клітора', 'вагінальні': 'вагінальний',
    'анальні': 'анальний', 'для точки g': 'для точки g',
