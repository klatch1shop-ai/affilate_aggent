         'якісний', 'якісна', 'гнучкий', 'гнучка', 'ніжний', 'ніжна'}


# Числівники не є ані типом товару, ані означенням до нього.
NUMERALS = {'двома', 'трьома', 'одним', 'двох', 'трьох', 'двома', 'чотирма',
            'двіа', 'двi', 'дві', 'два', 'три', 'чотири', 'пʼять', 'шість'}


def _is_adj(w):
    """Чи слово схоже на означення в називному. -а/-я теж рахуємо: іменники
    на -а тут теж трапляються («пробка анальна»), але склеювання двох перших
    слів у обох випадках дає природну фразу, а от самотнє «анальна» — ні."""
    return w.endswith(('ий', 'ій', 'не', 'ні', 'ове', 'ова', 'а', 'я'))


# Іменники типу товару в НАЗИВНОМУ. Саме називний відрізняє пошукову фразу
# від склейки: покупець вводить «маска feral», а не «мастурбатора lovense».
# Список навмисно з точних форм — перевірка йде на рівність токена, не на
# входження підрядком, бо «мастурбатора» містить «мастурбатор» і проходило б.
DESC_NOM = set(DESC_NOUNS) | {
    'віброкільце', 'вібропробка', 'гідропомпа', 'чокер', 'повідець',
    'гель', 'олія', 'маска', 'помпа',
}
_LATIN = re.compile(r'^[a-z0-9\-]+$')


def _strict_pair(w1, w2):
    """Вузьке правило для шару 3: «тип товару в називному + бренд/модель».

    Заміряно на 84 фразах, видалених повним вимкненням шару: правило пропускає
    9 фраз, з них 8 корисних → точність 89 %. Ширші варіанти перевірені й
    відкинуті: точний збіг токена з DESC_NOUNS без вимоги латиниці дав 32 %,
    а з нестрогим збігом основи — 56 %.

    Ціна: рятує 8 корисних фраз із 23, решта 15 лишаються відсіяними. Це
    свідомий обмін — без морфології відрізнити «ніжний мастурбатор» від
    «нашийник виготовлений» за закінченням неможливо.
    """
    return (any(w in DESC_NOM for w in (w1, w2))
            and any(_LATIN.match(w) for w in (w1, w2)))


def agree(adj_forms, noun):
    return adj_forms[GENDER_IDX[word_gender(noun)]]


def fill_tpl(tpl, noun):
    """Шаблон властивості з прикметником попереду узгоджується з типом:
    «гіпоалергенний затискачі», «гіпоалергенний кільце», «безшумний
    вагінальні кульки» — перевірка детектора 12.09.2026 (4 справжні помилки
    з 30 позначених, усі з цих шаблонів). Прикметники тут тверді: -ий."""
    m = re.match(r'([а-яіїєґ]+)ий \{n\}', tpl)
    if m:
        st = m.group(1)
        return f"{agree((st + 'ий', st + 'а', st + 'е', st + 'і'), noun)} {noun}" + tpl[m.end():]
    return tpl.format(n=noun)


_MODIFIER = {'бдсм', 'секс', 'міні', 'смарт'}
_FLUFF_ANY = re.compile(r'^(?:шикарн|розкішн|сексуальн|стильн|елегантн|преміальн|найдешевш|найкращ|'
                        r'компактн|потужн|ніжн|зручн|якісн|чарівн|спокуслив)')


def _adj_strict(w):
    """Означення в називному — лише за певними закінченнями. «Змазка»,
    «пробка», «свіча» — іменники; «густа», «м’яка», «золота» — означення."""
    b = w.rsplit('-', 1)[-1]
    if b in _NOUN_NA:
        return False
    return bool(re.search(r'(?:ий|ій)$', b) or _ADJ_END.search(b)
                or re.search(r"(?:ста|сте|сті|ота|оте|оті|яка|яке|які|ика|ике|гка)$", b))


def _name_type(nm):
    """Тип із початку назви: до першого латинського слова, цифри, коми, тире,
    лапок чи прийменника. Іменник + до двох означень перед ним + додаток у
    родовому («масажер простати», «набір вагінальних кульок»). Маркетингові
    епітети відкидаються. Порожньо — якщо іменника в цьому відрізку немає
    («Вакуумний KISSTOY стимулятор»), тоді працює старий розбір.

    Замінило кілька латок одного дня (12.09.2026), кожна з яких лікувала
    один вид назви й ламала інший: «густа анальна» без іменника, «шикарний
    вакуумний», «смарт» замість «смарт мастурбатор», «прикраса руку»,
    «гідропомпа діаметр», «віброкуля стимулювальними»."""
    m = _REGION_END.search(nm)
    region = nm[:m.start()] if m else nm
    ws = [w for w in re.findall(r"[а-яіїєґ][а-яіїєґ'’\-]{2,}", region)
          if w not in NUMERALS and w not in NOT_A_NOUN]
    while ws and (ws[0] in FLUFF or _FLUFF_ANY.match(ws[0])):
        ws = ws[1:]
    if not ws or not nm.lstrip(' «"').startswith(tuple(ws[:1])) and not region.strip():
        return ''
    i = next((k for k, w in enumerate(ws) if not _adj_strict(w) and w not in _MODIFIER), None)
    if i is None:
        return ''
    out = ws[max(0, i - 2):i + 1]
    rest = ws[i + 1:]
    k = 0
    while k < min(len(rest), 2) and re.search(r'(?:их|ого|ої)$', rest[k]):
        k += 1
    if 0 < k < len(rest):
        out += rest[:k + 1]           # «набір (розігрівальних) масажних олій»
    elif rest and rest[0].endswith(('и', 'і', 'ів', 'ок', 'ей', 'а', 'я')) \
            and not _adj_strict(rest[0]):
        out.append(rest[0])                           # «масажер простати»
    return ' '.join(out)


def _adj_gender(adj):
    """Рід прикметника за закінченням; None — не схоже на прикметник."""
    a = (adj or '').lower()
    if a.endswith(('ий', 'ій')):
        return 'm'
    if a.endswith(('на', 'ва', 'ла', 'ка', 'та', 'ра', 'ня', 'я')):
        return 'f'
    if a.endswith(('не', 'ве', 'ле', 'ке', 'те', 'ре', 'нє', 'є')):
        return 'n'
    if a.endswith(('ні', 'ві', 'лі', 'кі', 'ті', 'рі', 'ї')):
        return 'p'
    return None


def stem_set(phrase):
    """Множина основ слів. Prom зчитує «вібратор для жінок», «вібратори для
    жінок» і «вібратори жіночі» як один набір — клони не мають займати слоти."""
    return frozenset(w[:5] for w in re.findall(r'\w+', phrase.lower()) if len(w) > 2)


_ALT_SPLIT = re.compile(r"[\\s/\\-]+")


_TAIL_STOP = {'для', 'з', 'із', 'зі', 'на', 'у', 'в', 'до', 'по', 'від',
              'та', 'і', 'й', 'без', 'при', 'під', 'над'}


def _noun_like(w):
    """Чи слово — іменник типу товару. Порівнюємо з DESC_NOUNS за основою,
    бо в назві слово стоїть у будь-якому відмінку й числі."""
    w = str(w).lower()
    return any(w.startswith(n[:5]) or n.startswith(w[:5]) for n in DESC_NOUNS)


# прикметник або числівник у непрямому відмінку після прийменника:
# «на водній», «зі страусиним», «з дерев'яною», «з різними», «із двома»
_OBL_ADJ = re.compile(r"(?:ого|ому|ими|им|их|ій|ої|ною|ьою|вою|ма|ох)$")
_REGION_END = re.compile(r"[a-z0-9,;:(«\"“]|\s[-–—]\s|\s(?:"
                         + '|'.join(sorted(_TAIL_STOP, key=len, reverse=True)) + r")\s")
_PREP_RE = re.compile(r'\s(' + '|'.join(sorted(_TAIL_STOP, key=len, reverse=True))
                      + r')\s')


def prep_type(name, noun):
    """Тип із прийменниковою групою, якщо в назві вона стоїть одразу після
    типу й після прийменника іменник: «насадка на член», «вібратор для
    точки g», «кріплення для душу», «затискач для сосків». Раніше тут
    виходило «насадка член» — прийменник випадав (12.09.2026)."""
    nm = (name or '').lower()
    if not noun:
        return ''
    m = re.search(rf'(?<![\w-]){re.escape(noun)}\s({_PREP_RE.pattern[3:-3]})\s'
                  rf"([а-яіїєґ'’\-]{{3,}})(?:\s([a-z])(?![\w-]))?", nm)
    if not m or _OBL_ADJ.search(m.group(2)) or m.group(2) in NUMERALS:
        return ''
    # група продовжується далі — фраза вийшла б обрізаною: «спрей для
    # посилення [слиновиділення]», «пінка для очищення [іграшок]»
    after = re.match(r"\s+([а-яіїєґ'’\-]+)", nm[m.end():])
    if not m.group(3) and after and len(after.group(1)) >= 3 \
            and after.group(1) not in _TAIL_STOP | {'або', 'для'}:
        return ''
    return f'{noun} {m.group(1)} {m.group(2)}' + (f' {m.group(3)}' if m.group(3) else '')


def _trim_tail(t):
    """Тип не може закінчуватись прийменником: «вакуумна помпа для» — це
    обрубок, а не тип. Заміряно 09.09.2026: 56 таких із 1371 зміни."""
    w = str(t).split()
    while len(w) > 1 and w[-1] in _TAIL_STOP:
        w.pop()
    return ' '.join(w)


def _head_confirmed(v, nm):
    """Чи є головне слово типу в назві.

    Перевіряється кожен кандидат: тип буває з альтернативами через «/»
    («портупея/збруя») і складений через дефіс («вібратор-кролик»), а назва
    може містити його всередині складного слова («Мастурбатор-торс»,
    «Смартвібратор-пульсатор»).

    Заміряно 09.09.2026 на 150 картках: суворий цілословний збіг виправив би
    6 карток і зламав 29, де слово стоїть у складі складного. Тому підрядок
    лишається — але від ПОВНОГО слова, а не від п'ятилітерного префікса.
    """
    for alt in str(v).split('/'):
        # Підтверджуємо ГОЛОВНЕ слово, а не будь-яку частину складеного типу.
        # Інакше «вібратор-насадка на палець» підтверджувався словом
        # «вібратор» із назви, і вібратор точки G ставав насадкою на палець.
        parts = [w for w in _ALT_SPLIT.split(_trim_tail(alt.strip())) if w]
        if not parts:
            continue
        head = parts[-1]
        if len(head) >= 4 and (head in nm or head[:-1] in nm):
            return True
    return False


def _verified_type(v, nm, prm, src_key):
    """Прибирає з типу означення, не підтверджені нічим, крім самого типу.

    ЧОМУ. Докстрінг head_noun обіцяв перевірку типу назвою, але перевірялось
    лише останнє слово — означення не звірялось узагалі. Звідси «класичний
    вібратор» на гелі, «класична анальна пробка» на металевій із хвостиком.
    Заміряно на 150 картках: 15.3 % карток мали непідтверджене означення,
    12 % — саме «класичний».

    Підтвердження береться з назви АБО з ІНШОЇ характеристики, але НІКОЛИ з
    того параметра, що дав тип: інакше хибне значення підтверджує само себе.
    Саме так 20 із 38 «класичних» виявились законними — їх підтверджує
    окреме поле «Форма: класична конусна».

    Нічого не вигадуємо: непідтверджене слово просто відкидається.
    """
    words = str(v).split()
    if len(words) < 2:
        return v
    other = set()
    for k2, v2 in (prm or {}).items():
        if k2 == src_key:
            continue
        other |= {w[:6] for w in re.findall(r"[а-яіїєґa-z0-9']+", str(v2).lower())}
    nmw = {w[:6] for w in re.findall(r"[а-яіїєґa-z0-9']+", nm)}
    kept = [w for w in words[:-1] if w[:6] in nmw or w[:6] in other]
    return ' '.join(kept + [words[-1]])


def head_noun(prm, category, name=''):
    '''Тип із характеристик беремо лише тоді, коли він **підтверджується
    назвою**. У фіді трапляється «Тип товару: анальний душ» у вібропробки —
    і тоді всі дев'ять фраз будуються навколо чужого слова. Назва, яку писав
    постачальник, надійніша за параметр, який хтось колись змапив.'''
    nm = (name or '').lower()
    best = None
    for k in TYPE_PARAMS:
        v = (prm.get(k) or '').strip().lower().split('|')[0].strip()
        if not v or v in NOT_A_NOUN:
            continue
        if _head_confirmed(v, nm):
            vt = _verified_type(v, nm, prm, k)
            # «вібратори для пар» при назві «Смартвібратор для пар» лишало
            # тип «для пар» — іменник не підтвердився, прийменник лишився
            # (2 картки × 9 фраз, 12.09.2026). Такий тип — не тип.
            if vt.split()[0] not in _TAIL_STOP:
                return vt
            continue
        best = best or v
    t = _name_type(nm)
    if t:
        return t
    # Назва починається з означення («Анальна вібропробка», «Потужний
    # мінівібратор»), тому одне перше слово брати не можна — це прикметник.
    # Беремо перші два змістовні слова, відкинувши маркетингові епітети.
    # Мінімум 3 літери, а не 4: інакше випадають короткі іменники — «душ»,
    # «гель», «жгут». «Анальний душ із двома насадками» давав головне слово
    # «анальний двома», бо «душ» не проходив довжину.
    # Апостроф — частина слова: «пов'язка», «об'єм», «м'ясо». Без нього
    # «Пов'язка на очі» давала головне слово «пов», і всі ключі будувались
    # навколо обрубка.
    words = [w for w in re.findall(r"[а-яіїєґ][а-яіїєґ'’\-]{2,}", nm)
             if w not in NOT_A_NOUN and w not in FLUFF and w not in NUMERALS]
    # Тип — до першого латинського слова (бренд/модель), якщо там є іменник:
    # «Мастурбатор-вагіна Fleshlight Pink Lady Mini-Lotus Нова текстура»
    # давало «мастурбатор-вагіна нова» — слова по обидва боки моделі
    # склеювались, а _is_adj вважав «вагіна» прикметником (SO6140,
    # 12.09.2026). Якщо до бренду лише прикметник («Вакуумний KISSTOY
    # стимулятор») — лишаємо стару логіку по всій назві.
    pre = [w for w in re.findall(r"[а-яіїєґ][а-яіїєґ'’\-]{2,}",
                                 re.split(r'[a-z]', nm, maxsplit=1)[0])
           if w not in NOT_A_NOUN and w not in FLUFF and w not in NUMERALS]
    if pre and any(_noun_like(w) for w in pre):
        words = pre
    # Тип закінчується перед першим прийменником: «Змазка на водній основі»
    # давало «змазка водній» (34 фрази), «Лоскітка зі страусиним пером» —
    # «лоскітка страусиним», «Спринцівка зі зворотним клапаном» — «…
    # зворотним» (93 картки, 12.09.2026). Короткі прийменники регулярний
    # вираз слів і так пропускав, тож слова по обидва боки склеювались.
    # Прийменникову групу з іменником («насадка на член») у тип не беремо —
    # тип стоїть у кожній фразі й узгоджується з кольором/матеріалом, а
    # довгий тип ламав і те, й інше; вона йде окремою фразою (prep_type).
    cut = _PREP_RE.search(nm)
    lat = re.search(r'[a-z]', nm)
    if cut and (not lat or cut.start() < lat.start()):
        rw = [w for w in re.findall(r"[а-яіїєґ][а-яіїєґ'’\-]{2,}", nm[:cut.start()])
              if w not in NOT_A_NOUN and w not in FLUFF and w not in NUMERALS]
        if len(rw) == 1 and rw == words[:1]:
            return rw[0]
        if (len(rw) == 2 and rw == words[:2]
                and rw[1].endswith(('и', 'і', 'ів', 'ок', 'ей'))):
            # родовий відмінок — частина типу: «Масажер простати з вібрацією»
            # → «масажер простати» (а «Лубрикант змазка-крем з…» — ні)
            return ' '.join(rw)
        if 2 <= len(rw) <= 3 and rw == words[:len(rw)]:
            words = rw
    if words:
        # Два слова замало, коли обидва — означення: «Металева анальна пробка»
        # давала «металева анальна» без самого іменника. Заміряно 09.09.2026:
        # 95 таких типів із 758 змінених. Тому беремо ще одне слово, поки
        # останнє взяте лишається схожим на прикметник, але не більше трьох —
        # довший «тип» перестає бути типом.
        # Третє слово беремо лише тоді, коли перші два НЕ містять іменника
        # типу, а третє — містить. На _is_adj тут спиратись не можна: він
        # вважає прикметником «олія», «пробка», «куля» (закінчення а/я), і
        # правило дало «масажна олія бадьорна» замість «масажна олія».
        if (len(words) > 2
                and not any(_noun_like(w) for w in words[:2])
                and _noun_like(words[2])
                and words[2][:5].lower() not in (words[0] + words[1]).lower()):
            return _trim_tail(f'{words[0]} {words[1]} {words[2]}')
        if len(words) > 1 and _is_adj(words[0]):
            # «Пов'язка-стрічка пов'язка» — друге слово повторює перше
            # (у назві воно є і в дужках). Склеюємо лише різні корені.
            if words[1][:5].lower() not in words[0].lower():
                return _trim_tail(f'{words[0]} {words[1]}')
        return words[0]
    return best or (category or '').lower().rstrip('и') or 'іграшка'


def contradicts(phrase, purpose, name=''):
    """Ключ називає одну зону, а характеристика — іншу. Зона з самої назви
    суперечністю не є: «Звуковий стимулятор клітора» з «Призначення: для
    стимуляції грудей» втрачав усі фрази з типом (SO8101, 12.09.2026) —
    назва надійніша за параметр."""
    if not purpose:
        return False
    p = purpose.lower()
    nm = (name or '').lower()
    for token, zone in ZONE.items():
        if token in phrase.lower() and token not in nm and zone not in p and p not in zone:
            # «вагінально-кліторні» містить обидві зони — це не суперечність
            if not any(z.split()[-1] in p for z in (zone,)):
                return True
    return False


def build(name, vendor, category, prm, description='', catname=None):
    catname = catname or category
    noun = head_noun(prm, category, name)
    ven = real_vendor(vendor)
    cyr = brand_cyr(ven, 'ua')
    purpose = (prm.get('Призначення') or '').lower()
    color = (prm.get('Колір') or '').split('|')[0].strip().lower()
    mat = (prm.get('Матеріал') or '').split('|')[0].strip().lower()
    slots = collections.OrderedDict()

    def add(layer, phrase):
        phrase = re.sub(r'\s+', ' ', phrase).strip().lower()
        lo = 1 if layer == 0 else 2      # «фалоімітатор» сам по собі — робочий запит
        if not (lo <= len(phrase.split()) <= 4):
            return
        if phrase in BROAD or not natural(phrase):
            return
        if contradicts(phrase, purpose, name):
            return
        if stem_set(phrase) in {stem_set(p) for p in slots}:
            return
        slots.setdefault(phrase, layer)

    # 0  базові категорійні фрази — спільні на всю категорію і це нормально
    cat_l = re.sub(r'[^а-яіїєґ\s-]', ' ', (category or '').lower()).strip()
    cat_l = re.sub(r'\s+', ' ', cat_l).replace('-', ' ')
    if cat_l:
        add(0, cat_l)
    for key, base in CATEGORY_BASE.items():
        if key in cat_l or key in noun:
            add(0, base)
            break

    # 1–2  точна категорія / конструктив
    add(1, noun)
    pt = prep_type(name, noun)
    if pt:
        add(1, pt)
    ph = PURPOSE_PHRASE.get(purpose)
    if ph in PURPOSE_ADJ:
        ph = agree(PURPOSE_ADJ[ph], noun)
    if ph:
        add(1, f'{noun} {ph}' if ph.startswith(('для', '3')) else f'{ph} {noun}')
    if (prm.get('Конструкція') or '').strip().lower().startswith('подвійн'):
        # чотири роди, а не два: було «подвійна кільце», «подвійна
        # віброяйця» — 50 фраз у фіді (12.09.2026)
        add(1, f"{agree(('подвійний', 'подвійна', 'подвійне', 'подвійні'), noun)} {noun}")

    # 3–4  бренд
    if ven:
        add(2, f'{noun} {ven.lower()}')
        if cyr:
            add(2, f'{noun} {cyr.lower()}')
        model = re.sub(re.escape(ven), '', name, flags=re.I)
        model = re.sub(r'[^\w\s-]', ' ', model)
        mw = [w for w in model.split() if re.match(r'^[A-Za-z][A-Za-z0-9-]{2,}$', w)][:2]
        if mw:
            add(2, f'{ven.lower()} {" ".join(mw).lower()}')

    # 5–6  колір, матеріал, живлення
    # Колір — не косметика, а спосіб розвести варіанти одного товару. Дві
    # картки «чокер чорний» і «чокер червоний» з однаковими ключами
    # конкурують між собою: Prom обирає одну, друга просідає. Колір у ключі
    # знімає цю конкуренцію й забирає весь НЧ-трафік за конкретним кольором.
    if color in COLOR_ADJ:
        add(3, f'{agree(COLOR_ADJ[color], noun)} {noun}')
        if ven:
            add(3, f'{agree(COLOR_ADJ[color], noun)} {noun} {ven.lower()}')
    for key, forms in MATERIAL_ADJ.items():
        # «безлатексний» містить «латекс» — було «латексний безлатексні
        # презервативи» (12.09.2026)
        if key in mat and f'без{key}' not in mat:
            add(3, f'{agree(forms, noun)} {noun}')
            break
    power = (prm.get('Тип живлення') or '').lower()
    if 'акум' in power or 'usb' in (description or '').lower():
        add(3, f'{noun} на акумуляторі')
    elif 'батар' in power:
        add(3, f'{noun} на батарейках')

    # 7–8  особливість
    if (prm.get('Водонепроникний') or '').lower().startswith('так'):
        add(4, f'{agree(WATERPROOF_ADJ, noun)} {noun}')
    modes = prm.get('Кількість режимів вібрації') or prm.get('Кількість режимів роботи')
    if modes and str(modes).strip().isdigit():
        add(4, f'{noun} {str(modes).strip()} режимів')
    if (prm.get('Керування через застосунок (Smart)') or '').lower().startswith('так'):
        add(4, f'смарт {noun}')

    # 7–8  габарит: єдине, що відрізняє Small/Medium/Large одного артикула.
    # Без нього три варіанти однієї моделі дістають майже однаковий набір.
    dia = (prm.get('Діаметр') or '').strip().replace(',', '.')
    ln = (prm.get('Довжина') or '').strip().replace(',', '.')
    if not dia:                       # у фіді габарит часто лише в тексті назви
        mo = re.search(r'діаметр\w*\s*[-–]?\s*(\d+[.,]?\d*)\s*см', name, re.I)
        if mo:
            dia = mo.group(1).replace(',', '.')
    if not ln:
        mo = re.search(r'довжин\w*\s*[-–]?\s*(\d+[.,]?\d*)\s*см', name, re.I)
        if mo:
            ln = mo.group(1).replace(',', '.')
    vol = (prm.get('Об`єм') or prm.get("Об'єм") or prm.get('Об’єм') or '').strip()
    size = (prm.get('Розмір') or '').strip().lower()
    try:
        if dia and float(dia) >= 2:
            add(4, f'{noun} діаметр {round(float(dia))} см')
    except ValueError:
        pass
    try:
        if ln and float(ln) >= 8:
            add(4, f'{noun} {round(float(ln))} см')
    except ValueError:
        pass
    if vol and vol.replace('.', '').isdigit():
        add(4, f'{noun} {vol.split(".")[0]} мл')
    # Розмір беремо лише там, де він осмислений. У фіді трапляється «Розмір: L»
    # у парфумів — сміттєва характеристика, яка інакше потрапила б у ключі.
    if size and len(size) <= 4 and size not in NOT_A_NOUN and \
       re.search(r'білизн|костюм|чаш|боді|панчох|корсет', category, re.I):
        add(4, f'{noun} розмір {size}')

    # 7–8  ознаки з тексту — рятують «бідні» категорії без характеристик
    src = f'{name} {description[:900]}'
    for pat, tpl in FEATURE:
        # Основа (водна/силіконова) — властивість засобу, а не іграшки: в
        # описі мастурбатора «використовуйте з лубрикантом на водній основі»
        # давало «мастурбатор на водній основі» (SX4011, 12.09.2026). Тому
        # з опису — лише для рідких засобів, інакше тільки з назви.
        if 'основ' in pat and not re.search(LIQUID, noun):
            if re.search(pat, name, re.I):
                add(4, fill_tpl(tpl, noun))
            continue
        if re.search(pat, src, re.I):
            add(4, fill_tpl(tpl, noun))

    # 9  синонім / альтернатива — те, як товар називають покупці
    # Голий синонім («штучна вагіна») повторився б на сотнях карток — це той
    # самий дубль, лише під іншою назвою. Тому синонім іде з модифікатором.
    for key, syns in SYNONYM.items():
        if key in noun:
            for sy in syns:
                if ven:
                    add(5, f'{sy} {ven.lower()}')
                elif color in COLOR_ADJ:
                    # узгоджено з синонімом: було «штучна вагіна чорний»,
                    # «бдсм наручники рожевий» (12.09.2026)
                    add(5, f'{agree(COLOR_ADJ[color], sy)} {sy}')
                else:
                    add(5, sy)
            break
    if ven and cyr:
        add(5, f'{cyr.lower()} {noun}')

    # шар 3: предметні словосполучення з опису
    #
    # ВИМКНЕНО 08.09.2026 після заміру на всьому фіді. Запобіжник _is_adj
    # спирається на закінчення, а `а`/`я`/`ні` збігаються з родовим і місцевим
    # відмінком іменників («лубриканта», «страпона», «ванні»). Тому XOR-фільтр
    # «означення + іменник» пропускав склейки з тексту: «лубрикантом водній»,
    # «означає насадка», «вимикається стимулятор».
    # Масштаб: 2574 картки (47.9 %), 4777 фраз (11.4 % усіх слотів).
    # Спирається на правило з докстрінгу цього ж файла: сміттєвий ключ гірший
    # за порожній слот — порожній не несе негативного сигналу, сміттєвий дає
    # покази без кліків.
    # Вмикати назад можна лише разом зі справжнім визначенням частини мови
    # (морфологічна бібліотека), а не правкою списку закінчень.
    if DESC_BIGRAMS and len(slots) < MAX_SLOTS and description:
        plain = re.sub(r'<[^>]+>', ' ', description[:1500]).lower()
        # `&\w+;` знімав `&mdash;` і `&rsquo;`, але НЕ числові `&#39;`:
        # `\w+` не матчить `#39`, і слово рвалось — «підв&#39;язками» → «підв».
        plain = re.sub(r'&#?\w+;', ' ', plain)
        words = re.findall(r'[а-яіїєґa-z0-9\'-]{3,}', plain)
        for i in range(len(words) - 1):
            pair = f'{words[i]} {words[i+1]}'
            if any(w in DESC_STOP or w in DESC_LABELS
                   for w in (words[i], words[i + 1])):
                continue
            if not any(nn in pair for nn in DESC_NOUNS):
                continue
            # Люди шукають «чорна маска», а не «товару маска». Тому пара має
            # бути «означення + іменник» або «іменник + означення»; іменник у
            # непрямому відмінку поруч з іншим іменником — це склейка з тексту,
            # а не пошукова фраза.
            a0 = _is_adj(words[i]); a1 = _is_adj(words[i + 1])
            if not (a0 ^ a1):
                continue
            if DESC_STRICT and not _strict_pair(words[i], words[i + 1]):
                continue
            add(4, pair)
            if len(slots) >= MAX_SLOTS:
                break

    # шар 4: функціональні властивості — як покупець описує проблему
    if len(slots) < MAX_SLOTS:
        src = f'{name} {description[:1200]}'
        for pat, tpl in FUNCTIONAL:
            if re.search(pat, src, re.I):
                add(5, fill_tpl(tpl, noun))

    # --- резерв: добираємо до безпечного мінімуму, не далі -------------------
    if len(slots) < MIN_SAFE:
        form = (prm.get('Форма') or '').split('|')[0].strip().lower()
        # Форма — прикметник, тож мусить узгоджуватися з типом у роді, і не
        # стосується рідин: «класична конусна густа змазка», «конусна
        # уретральний стимулятор», «класична конусна анальний ланцюжок» —
        # 24 картки, значення поля «Форма» в них від пробок (12.09.2026).
        if (form and form not in NOT_A_NOUN
                and not re.search(LIQUID, noun)
                and _adj_gender(form.split()[-1]) in (None, word_gender(noun))):
            add(6, f'{form} {noun}' if not form.startswith(noun.split()[0]) else form)
        for key, ph in PURPOSE_PHRASE_CAT.items():
            if key in (catname or '').lower() or key in noun:
                add(6, ph)
                break
        d = None
        raw = (prm.get('Діаметр') or '').replace(',', '.')
        if raw.replace('.', '').isdigit():
            d = float(raw)
            if d < 100:            # ще не нормалізовано — сантиметри
                d *= 10
        if d:
            for lim, lvl in LEVEL_BY_DIAMETER:
                if d <= lim:
                    if lvl:
                        add(6, f'{noun} {lvl}')
                    break
        if mat:
            for key, forms in MATERIAL_ADJ.items():
                if key in mat and f'без{key}' not in mat:
                    add(6, f'{agree(forms, noun)} {noun}')
                    break
        if color in COLOR_ADJ:
            add(6, f'{agree(COLOR_ADJ[color], noun)} {noun}')

    return list(slots)[:MAX_SLOTS]


def txt(o, tag):
    e = o.find(tag)
    return (e.text or '').strip() if e is not None else ''


# Контроль правила типу з назви (11.5/11.6 AGENT_RULES). Об'єднане правило
# `_name_type` елегантніше за латки, які воно замінило, — але саме тому
# його зміна може тихо зламати інший вид назви. Кожна пара перевірена
# вручну 12.09.2026; ліворуч — вид назви, що вже раз ламався.
NAME_TYPE_CASES = [
    ('Розкішні вагінальні кульки PILLOW TALK', 'вагінальні кульки'),
    ('Металеві вагінальні кульки Rosy Gold', 'металеві вагінальні кульки'),
    ('Натуральна харчова добавка для підвищення лібідо', 'натуральна харчова добавка'),
    ('Смарт мастурбатор Lelo F1S', 'смарт мастурбатор'),
    ('Прикраса на руку Art of Sex', 'прикраса'),
    ('Шикарний вакуумний кліторальний стимулятор Romp', 'вакуумний кліторальний стимулятор'),
    ('Сексуальні шкіряні гартери з поясом', 'шкіряні гартери'),
    ('Розтяжка на ліжко Punishment', 'розтяжка'),
    ('Вібратор-кролик із пульсацією Good Vibes', 'вібратор-кролик'),
    ('Густа анальна змазка JO', 'густа анальна змазка'),
    ('Масажер простати Fun Factory', 'масажер простати'),
    ('Найдешевший масажер простати Alive Nero', 'масажер простати'),
    ('Набір вагінальних кульок зі зміщеним центром', 'набір вагінальних кульок'),
    ('Набір розігрівальних масажних олій EXSENS', 'набір розігрівальних масажних олій'),
    ('Гідропомпа Bathmate Hydro 7', 'гідропомпа'),
    ('Віброкуля Adrien Lastic Pocket Vibe', 'віброкуля'),
    ('Вакуумний KISSTOY стимулятор', 'вакуумний стимулятор'),
    ('Лубрикант змазка-крем з кокосовою олією', 'лубрикант'),
    ('Збуджувальний засіб бальзам для клітора', 'збуджувальний засіб'),
    ('Змазка на водній основі JO', 'змазка'),
    ('Насадка на член Kokos', 'насадка'),
    ('Колесо Вартенберга Liebe Seele', 'колесо вартенберга'),
    ('Еротична гра «Пантомім Asgard Games»', 'еротична гра'),
    ('М’яка пінка для очищення іграшок JO', 'м’яка пінка'),
    ('Компактна смарт секс-машина Zalo', 'смарт секс-машина'),
    ('Анальна пробка з хвостом', 'анальна пробка'),
    ('Потрійне ерекційне кільце Boners', 'потрійне ерекційне кільце'),
    ('Вібратор для точки G Fun Factory', 'вібратор'),
    ('Мастурбатор-вагіна Fleshlight', 'мастурбатор-вагіна'),
    ('Алюмінієва анальна пробка з вібрацією', 'алюмінієва анальна пробка'),
    ('Синя воскова свічка Art of Sex', 'синя воскова свічка'),
    ('Ультратонкі безлатексні презервативи SKYN', 'ультратонкі безлатексні презервативи'),
    ('Звуковий стимулятор клітора LELO SONA', 'звуковий стимулятор клітора'),
]


def selftest_name_type(verbose=True) -> bool:
    bad = [(n, want, head_noun({}, '', n)) for n, want in NAME_TYPE_CASES
           if head_noun({}, '', n) != want]
    for n, want, got in bad:
        print(f'  ✗ тип із назви: «{n}» → «{got}», очікувалось «{want}»')
    if verbose:
        print(f'контроль типу з назви: {len(NAME_TYPE_CASES) - len(bad)}/{len(NAME_TYPE_CASES)}')
    return not bad


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--selftest', action='store_true', help='лише контроль правила типу')
    ap.add_argument('--sample', type=int, default=0)
    ap.add_argument('--report', action='store_true')
    a = ap.parse_args()
    if a.selftest:
        sys.exit(0 if selftest_name_type() else 1)

    root = ET.parse(FEED).getroot()
    cats = {c.get('id'): (c.text or '') for c in root.findall('.//category')}
    offers = root.findall('.//offer')

    old_all, new_all = collections.Counter(), collections.Counter()
    old_cnt, new_cnt = [], []
    contra_old = contra_new = 0
    shown = 0
    for o in offers:
        prm = {p.get('name'): (p.text or '') for p in o.findall('param')}
        name = txt(o, 'name_ua')
        desc = re.sub(r'<[^>]+>', ' ', txt(o, 'description_ua'))
        new = build(name, txt(o, 'vendor'), cats.get(txt(o, 'categoryId'), ''), prm, desc)
        old = [x.strip() for x in txt(o, 'keywords_ua').split(',') if x.strip()]
        purpose = (prm.get('Призначення') or '').lower()
        contra_old += sum(1 for p in old if contradicts(p, purpose))
        contra_new += sum(1 for p in new if contradicts(p, purpose))
        for p in old:
            old_all[p] += 1
        for p in new:
            new_all[p] += 1
        old_cnt.append(len(old)); new_cnt.append(len(new))
        if a.sample and shown < a.sample and len(new) >= 5:
            print('=' * 92)
            print(name)
            print('  БУЛО :', ', '.join(old))
            print('  СТАЛО:', ', '.join(new))
            shown += 1

    if a.report or not a.sample:
        def uniq(c):
            return f'{len(c)} унікальних на {sum(c.values())} вживань ' \
                   f'({100 * len(c) // max(1, sum(c.values()))} %)'
        print(f'\nтоварів: {len(offers)}')
        print(f'  БУЛО : {uniq(old_all)}; фраз на товар у середньому '
              f'{sum(old_cnt)/max(1,len(old_cnt)):.1f}')
        print(f'  СТАЛО: {uniq(new_all)}; фраз на товар у середньому '
              f'{sum(new_cnt)/max(1,len(new_cnt)):.1f}')
        print(f'  суперечностей із «Призначенням»: було {contra_old} → стало {contra_new}')
        print(f'  товарів із < {MIN_SLOTS} фраз: було '
              f'{sum(1 for x in old_cnt if x < MIN_SLOTS)} → стало '
              f'{sum(1 for x in new_cnt if x < MIN_SLOTS)}')
        print('\n  найчастіші фрази ПІСЛЯ:')
        for p, v in new_all.most_common(8):
            print(f'    {v:5}  {p}')


if __name__ == '__main__':
    main()
