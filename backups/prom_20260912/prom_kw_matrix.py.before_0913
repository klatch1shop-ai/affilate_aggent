#!/usr/bin/env python3
"""
tools/prom_kw_matrix.py
========================
Пошукові запити Prom за тришаровою матрицею (консультація 02.09.2026).

ЧОМУ ПЕРЕРОБКА. Заміри поточного фіду: 86 % товарів мають 9 фраз, але
унікальних фраз лише 4338 на 46797 вживань. «Жіночі вібратори» стоять на
1431 товарі, і 2752 товари (половина фіду) мають набір, повністю однаковий
із чиїмось іншим.

Прямого покарання за це немає — Prom не має поняття канібалізації, ранжує за
CTR, конверсією і ставкою ProSale. Втрата в іншому: слот, зайнятий фразою
«жіночі вібратори», не приносить показів (ми на 15-й сторінці такої видачі),
але й не приносить НЧ-трафіку, який конвертує. Це втрачена можливість, а не
штраф.

Натомість **шкода** є від двох речей, і обидві виправляються тут:

  * **суперечність ключа й характеристики** (285 товарів: ключ «для клітора»
    при «Призначення: вагінальні»). Prom не звіряє поля семантично, але
    покупець, який шукав клітор, картку не відкриє → падає CTR → ProSale
    занижує картку **за всіма** запитами, зокрема правильними. Плюс товар
    однаково не пройде фасетний фільтр у лівому меню;
  * **сміттєвий ключ** — гірший за порожній слот. Порожній слот не несе
    негативного сигналу взагалі; сміттєвий дає покази без кліків.

СТРАТЕГІЯ ДЛЯ НОВОГО ПРОДАВЦЯ: 0 % чистих ВЧ, 30–40 % СЧ, 60–70 % НЧ.
Розкладка дев'яти слотів:

    1–2  точна категорія / конструктив     (СЧ)
    3–4  бренд латиницею + кирилицею       (НЧ/СЧ)
    5–6  колір + матеріал + живлення       (НЧ)
    7–8  особливість / призначення          (НЧ)
      9  синонім або альтернативна назва    (НЧ)

    python3 tools/prom_kw_matrix.py --sample 3
    python3 tools/prom_kw_matrix.py --report
"""
import os, re, sys, json, argparse, collections
import xml.etree.ElementTree as ET

BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, BASE)
sys.path.insert(0, os.path.join(BASE, 'tools'))
from prom_keywords import (brand_cyr, word_gender, real_vendor, natural,
                           GENDER_IDX, NOT_A_NOUN, _ADJ_END, _NOUN_NA)

FEED = os.environ.get('PROM_FEED') or os.path.join(BASE, 'output', 'noire_prom.xml')
MAX_SLOTS = 9
MIN_SLOTS = 4          # менше — краще, ніж добивати сміттям

# Друга базова фраза ширшого рівня: дає товару шанс потрапити у видачу за
# запитом, який покупець вводить, ще не знаючи конкретного типу.
CATEGORY_BASE = {
    # ключ шукається в назві категорії фіду або в головному слові товару
    'вібратор': 'інтимні іграшки', 'фалоімітатор': 'інтимні іграшки',
    'вакуумн': 'стимулятори клітора', 'секс-машин': 'інтимні іграшки',
    'пробк': 'анальні іграшки', 'анальн': 'анальні іграшки',
    'простат': 'анальні іграшки', 'спринцівк': 'анальні іграшки',
    'мастурбатор': 'іграшки для чоловіків', 'кільц': 'іграшки для чоловіків',
    'насадк': 'іграшки для чоловіків', 'помп': 'іграшки для чоловіків',
    'екстендер': 'іграшки для чоловіків', 'ляльк': 'іграшки для чоловіків',
    'бдсм': 'бдсм аксесуари', 'фетиш': 'бдсм аксесуари',
    'страпон': 'бдсм аксесуари', 'меблі': 'бдсм аксесуари',
    'білизн': 'еротична білизна', 'костюм': 'еротична білизна',
    'кульк': 'тренажери для жінок', 'кегел': 'тренажери для жінок',
    'чаш': 'жіноча гігієна', 'гігієн': 'жіноча гігієна',
    'олія': 'засоби для масажу', 'свічк': 'засоби для масажу',
    'масажн': 'засоби для масажу', 'ванн': 'засоби для масажу',
    'лубрикант': 'інтимна косметика', 'мастил': 'інтимна косметика',
    'збуджу': 'інтимна косметика', 'парфум': 'інтимна косметика',
    'феромон': 'інтимна косметика', 'крем': 'інтимна косметика',
    'презерватив': 'засоби контрацепції',
    'подарунк': 'еротичні сувеніри', 'брелок': 'еротичні сувеніри',
    'догляду за інтимними': 'догляд за іграшками',
}

# Чисті ВЧ без контексту. Слот під них не витрачаємо: у такій видачі нас не
# видно, а CTR від «порожніх» показів тягне картку вниз.
# ВИПРАВЛЕНО 02.09.2026 після оцінки консультанта. Спершу я заборонив усі
# частотні фрази — і зрізав середнє до 4.8 фрази, лишивши 1670 товарів із
# трьома й менше. Це помилка: спільна категорійна фраза не є канібалізацією.
# Вона — **вхідний квиток у видачу**. Сто пробок зі спільним ключем «анальна
# пробка» не заважають одна одній: Prom виводить усі сто й ранжує їх за
# ProSale, ціною та наявністю. Без цього ключа товар невидимий узагалі.
#
# Тому забороняємо лише те, що не описує товар **ніяк**: у такій фразі немає
# ані типу, ані призначення, тож покази за нею справді порожні.
BROAD = {
    'товари для дорослих', 'іграшки для дорослих', 'секс шоп', 'секс шоп україна',
    'подарунок дівчині', 'подарунок хлопцю', 'подарунок на день народження',
    'інтим магазин', 'дешеві іграшки', 'найкращі іграшки',
}
# Формула безпеки: 2–3 базові категорійні фрази + 3–4 унікальні деталі.
# Шар 3 (біграми з опису). Повне вимкнення коштувало надто дорого: ручна
# оцінка 84 видалених фраз на вибірці 40 карток показала, що 23 з них (27.4 %)
# були робочими пошуковими фразами, а не сміттям — по каталогу це ~1236 фраз.
# Тому шар лишається увімкненим, але з вузьким правилом DESC_STRICT.
DESC_BIGRAMS = True
DESC_STRICT = True
MIN_SAFE = 6

# ── шар 3: опис як джерело ключів ─────────────────────────────────────────
# Для БДСМ, подарунків і сувенірів характеристик майже немає — генератор
# збирав по три фрази. Але опис у них великий і живий. Проблема в тому, що
# він на дві третини складається з маркетингового флуду, який у пошук ніхто
# не вводить. Тому беремо з опису лише **предметні** слова й відкидаємо
