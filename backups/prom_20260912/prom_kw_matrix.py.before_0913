}
# означення з PURPOSE_PHRASE, які узгоджуються з типом у роді
PURPOSE_ADJ = {'вагінальний': ('вагінальний', 'вагінальна', 'вагінальне', 'вагінальні'),
               'анальний': ('анальний', 'анальна', 'анальне', 'анальні')}
