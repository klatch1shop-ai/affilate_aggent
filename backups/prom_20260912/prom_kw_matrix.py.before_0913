    'пробка', 'плаг', 'кільце', 'чокер', 'нашийник', 'наручники', 'батіг',
    'флогер', 'кляп', 'маска', 'затискач', 'затискачі', 'повідець', 'портупея',
    'помпа', 'лубрикант', 'мастило', 'олія', 'свічка', 'гель', 'спрей',
    'презерватив', 'страпон', 'насадка', 'куля', 'кульки', 'яйце', 'ляльк',
    'корсет', 'боді', 'панчохи', 'трусики', 'сукня', 'костюм', 'халат',
