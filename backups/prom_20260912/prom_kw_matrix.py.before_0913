# ── шар 4: функціональні властивості ──────────────────────────────────────
# Те, як покупець описує товар через важливу для себе властивість:
# «безшумний», «для початківців», «водонепроникний». Це транзакційні запити
# з високою конверсією, і конкуренція за ними значно нижча. Джерело — самі
# дані картки, не вигадка.
FUNCTIONAL = [
    (r'безшумн|тих(?:ий|а)\s|низьк\w+\s+рівень\s+шуму|шепіт', 'безшумний {n}'),
    (r'для\s+початківц|новачк|перш\w+\s+досвід', '{n} для початківців'),
    (r'для\s+пар\b|парн\w+\s+ігор|удвох', '{n} для пар'),
    (r'дистанційн|пульт\s+ду|пульт\s+дк', '{n} з пультом'),
    (r'\bipx\s*[4-8]|водонепроникн|можна\s+занурюв', 'водонепроникний {n}'),
