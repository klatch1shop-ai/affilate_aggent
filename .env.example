# ── База даних (PostgreSQL у Docker на сервері) ───────────
DB_HOST=192.168.x.x
DB_PORT=5432
DB_NAME=agentdb
DB_USER=agentadmin
DB_PASSWORD=

# ── Redis (на сервері) ────────────────────────────────────
REDIS_HOST=192.168.x.x
REDIS_PORT=6379

# ── Qdrant (векторна БД на сервері) ──────────────────────
QDRANT_HOST=192.168.x.x
QDRANT_PORT=6333

# ── Ollama (локально на ноутбуці) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
OLLAMA_DEV_MODEL=deepseek-coder:6.7b-instruct-q4_K_M

# ── Епіцентр API ─────────────────────────────────────────
EPICENTR_TOKEN=
EPICENTR_API_URL=https://epicentrk.ua/api/v2

# ── Toptul XML фід ────────────────────────────────────────
TOPTUL_FEED_URL=

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# ── Prometheus / Моніторинг ───────────────────────────────
PROM_API_TOKEN=

# ── Claude / Anthropic API ────────────────────────────────
ANTHROPIC_API_KEY=

# ── Загальні налаштування ─────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
